# ---------- 下载 ----------

def fetch(url, dest, expect_sha1=None, expect_size=None):
    """下载文件, 显示进度, 支持续传, 失败返回 None"""
    os.makedirs(os.path.dirname(dest), exist_ok=True)
    headers = {"User-Agent": APP}
    have = os.path.getsize(dest) if os.path.exists(dest) else 0
    if have:
        headers["Range"] = f"bytes={have}-"
    try:
        req = urllib.request.Request(url, headers=headers)
        with urllib.request.urlopen(req, timeout=60) as r:
            total = int(r.headers.get("Content-Length", 0)) + have
            mode = "ab" if have else "wb"
            with open(dest, mode) as f:
                while True:
                    chunk = r.read(1 << 20)
                    if not chunk:
                        break
                    f.write(chunk)
                    done = f.tell()
                    pct = done * 100 // total if total else 0
                    print(f"\r  下载中 {done>>20}MB"
                          + (f"/{total>>20}MB {pct}%" if total else ""),
                          end="", flush=True)
            print()
    except urllib.error.HTTPError as e:
        if e.code == 416 and have:
            # Range 起点超出文件末尾 = 文件已下载完整
            print(c("  文件已完整, 跳过下载", "green"))
            return True
        print(c(f"  下载失败: {e}", "red"))
        return False
    except Exception as e:
        print(c(f"  下载失败: {e}", "red"))
        return False
    if expect_sha1:
        import hashlib
        h = hashlib.sha1()
        with open(dest, "rb") as f:
            for chunk in iter(lambda: f.read(1 << 20), b""):
                h.update(chunk)
        if h.hexdigest() != expect_sha1:
            print(c("  SHA1 校验失败, 文件可能损坏", "red"))
            return False
    return True


