def find_servers():
    """扫描 ~ 下含 .1b1t-open-server/config.json 的目录"""
    found = []
    seen = set()
    home = os.path.expanduser("~")
    try:
        entries = os.listdir(home)
    except OSError:
        return found
    for entry in entries:
        d = os.path.join(home, entry)
        if not os.path.isdir(d) or entry.startswith("."):
            continue
        if load_cfg(d):
            rp = os.path.realpath(d)
            if rp not in seen:
                seen.add(rp)
                found.append(d)
    return found


